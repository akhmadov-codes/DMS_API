# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` git'ga yuklanmaydi.

# --- Asosiy ---
# Production'da albatta False
DEBUG=False
# Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Vergul bilan ajratiladi (ko'rsatilmasa standart ro'yxat ishlaydi)
# ALLOWED_HOSTS=api-edo.tipme.uz,edo.tipme.uz,172.16.0.6,195.158.20.90,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://exa.tipme.uz,http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://api-edo.tipme.uz,https://exa.tipme.uz
# API_PUBLIC_URL=https://api-edo.tipme.uz/

# --- Ma'lumotlar bazasi ---
# Production qiymatlari (avval settings.py da DEBUG=False bo'lganda ishlatilgan)
DB_NAME=dms_db_utf8
DB_USER=dms_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Cookie ---
# Lokal (http) da admin panelga kirish uchun False qiling. Production'da True.
SECURE_COOKIES=True
